<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FotoAp.MainPage">

    <VerticalStackLayout Spacing="25" Padding="30" VerticalOptions="Center">

        <Image x:Name="capturedImage" HeightRequest="300" WidthRequest="300" Aspect="AspectFill" BackgroundColor="#E0E0E0" />

        <Button Text="Tomar Fotografía" Clicked="OnTakeCaptureClicked" />

        <Button Text="Subir a SQL Server" Clicked="OnUploadClicked" BackgroundColor="Green" TextColor="White" />

    </VerticalStackLayout>

</ContentPage>